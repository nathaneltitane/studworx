<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>swHTMLDialog</class>
 <widget class="QDialog" name="swHTMLDialog">
  <property name="whatsThis">
   <string>&lt;p&gt;&lt;b&gt;Export HTML&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Create browser-viewable building instructions and PNG images in the output folder. Choose which models to include, how to organize the step pages, and where to show parts lists.&lt;/p&gt;&lt;p&gt;Keep the generated HTML and image files together when copying or sharing the instructions.&lt;/p&gt;</string>
  </property>
  <property name="windowTitle">
   <string>HTML Options</string>
  </property>
  <layout class="QVBoxLayout" name="DialogLayout">
   <item>
    <widget class="QGroupBox" name="OutputGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Output Folder&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The exporter writes the instruction pages and their images into a folder named after the model inside this folder, starting at index.html, so nothing else in this folder is touched.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Output</string>
     </property>
     <layout class="QGridLayout" name="OutputLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="OutputFolderLabel">
        <property name="toolTip">
         <string>Folder for the generated HTML pages and images.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;&lt;b&gt;Output Folder&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The exporter writes the instruction pages and their images into a folder named after the model inside this folder, starting at index.html, so nothing else in this folder is touched.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Folder</string>
        </property>
        <property name="buddy">
         <cstring>outputFolder</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="outputFolder">
        <property name="toolTip">
         <string>Folder for the generated HTML pages and images.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;&lt;b&gt;Output Folder&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The exporter writes the instruction pages and their images into a folder named after the model inside this folder, starting at index.html, so nothing else in this folder is touched.&lt;/p&gt;</string>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QToolButton" name="outputFolderBrowse">
        <property name="toolTip">
         <string>Choose the folder for the exported instructions.</string>
        </property>
        <property name="accessibleName">
         <string>Choose Output Folder</string>
        </property>
        <property name="text">
         <string>...</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="ModelsGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Models&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Export instructions for the model and all submodels, only the model or submodel being edited, or that entry with its referenced submodels. When several entries are exported, an overall index links to their instructions.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Models</string>
     </property>
     <layout class="QVBoxLayout" name="ModelsLayout">
      <item>
       <widget class="QRadioButton" name="allModels">
        <property name="toolTip">
         <string>Export instructions for the model and all submodels.</string>
        </property>
        <property name="text">
         <string>All Models</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="currentModelSubmodels">
        <property name="toolTip">
         <string>Export the current model and the submodels it references.</string>
        </property>
        <property name="text">
         <string>Current Model and Submodels</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="currentModelOnly">
        <property name="toolTip">
         <string>Export instructions only for the current model.</string>
        </property>
        <property name="text">
         <string>Current Model Only</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="PagesGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Pages&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Single Page lays out the pages of the Instructions window on one scrolling index.html that stops at each page as you scroll up or down, with #page-1 and #step-1 links to jump to a page or step, and First, Previous, Next and Last Page arrows on the edge Arrows sets. Display lays the pages out for a screen in pixels: Instructions Page keeps the Instructions window page shape, while Landscape Display (1920 x 1080), Portrait Display (1080 x 1920) and Tablet (2048 x 1536) fill Width and Height and lay the exported pages out again at that shape. Pages are saved at twice the size for sharp high density screens, and blank print pages are left out. There the page colors and parts lists follow the Instructions window, unless Override Instructions Settings is checked. One Step per Page creates separate pages with navigation links. In that mode, Index Page adds a page linking to the steps.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Pages</string>
     </property>
     <layout class="QGridLayout" name="PagesLayout">
      <item row="0" column="0" colspan="2">
       <widget class="QRadioButton" name="singlePage">
        <property name="toolTip">
         <string>Put the Instructions window pages on one scrolling HTML page.</string>
        </property>
        <property name="text">
         <string>Single Page</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="arrowPositionLabel">
        <property name="toolTip">
         <string>Edge of the window that holds the page arrows.</string>
        </property>
        <property name="text">
         <string>Arrows</string>
        </property>
        <property name="buddy">
         <cstring>arrowPosition</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="arrowPosition">
        <property name="toolTip">
         <string>Edge of the window that holds the page arrows.</string>
        </property>
        <item>
         <property name="text">
          <string>Right</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Left</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Bottom</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="displayLabel">
        <property name="toolTip">
         <string>Screen shape the pages are laid out for, with its size in pixels.</string>
        </property>
        <property name="text">
         <string>Display</string>
        </property>
        <property name="buddy">
         <cstring>display</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="display">
        <property name="toolTip">
         <string>Screen shape the pages are laid out for, with its size in pixels.</string>
        </property>
        <item>
         <property name="text">
          <string>Instructions Page</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Landscape Display</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Portrait Display</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Tablet</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QRadioButton" name="oneStepPerPage">
        <property name="toolTip">
         <string>Create a separate HTML page for each step.</string>
        </property>
        <property name="text">
         <string>One Step per Page</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QCheckBox" name="indexPage">
        <property name="toolTip">
         <string>Add a step index when using One Step per Page.</string>
        </property>
        <property name="text">
         <string>Index Page</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="InstructionsGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Instructions&lt;/b&gt;&lt;/p&gt;&lt;p&gt;With Single Page, Override Instructions Settings uses the Settings Overrides colors, the Step Images background and the Parts List choices instead of the Instructions window settings. Only the exported pages change, never the model.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Instructions</string>
     </property>
     <layout class="QVBoxLayout" name="InstructionsLayout">
      <item>
       <widget class="QCheckBox" name="overrideInstructions">
        <property name="toolTip">
         <string>Use these colors, the Step Images background and the Parts List choices instead of the Instructions window settings.</string>
        </property>
        <property name="text">
         <string>Override Instructions Settings</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="OverrideGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Settings Overrides&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Colors of the exported pages while Override Instructions Settings is checked. Box Border and Box Background color the boxes around the step images, step numbers, parts lists, page numbers, cover title, cover author, cover image and notices.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Settings Overrides</string>
     </property>
     <layout class="QGridLayout" name="OverrideLayout"/>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="ImagesGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Step Images&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Width and Height set the step image size in pixels, from 1 to 32768 pixels. With Single Page they bound the page image size and keep the page proportions. Transparent Background leaves the image background clear, otherwise Background Color fills it and the frame around each image.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Step Images</string>
     </property>
     <layout class="QGridLayout" name="ImagesLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="StepWidthLabel">
        <property name="toolTip">
         <string>Width of each step image, in pixels.</string>
        </property>
        <property name="text">
         <string>Width</string>
        </property>
        <property name="buddy">
         <cstring>stepWidth</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1" colspan="2">
       <widget class="QLineEdit" name="stepWidth">
        <property name="toolTip">
         <string>Width of each step image, in pixels.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="StepHeightLabel">
        <property name="toolTip">
         <string>Height of each step image, in pixels.</string>
        </property>
        <property name="text">
         <string>Height</string>
        </property>
        <property name="buddy">
         <cstring>stepHeight</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1" colspan="2">
       <widget class="QLineEdit" name="stepHeight">
        <property name="toolTip">
         <string>Height of each step image, in pixels.</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="backgroundColorLabel">
        <property name="toolTip">
         <string>Color behind the model in the exported images.</string>
        </property>
        <property name="text">
         <string>Background Color</string>
        </property>
        <property name="buddy">
         <cstring>backgroundColor</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1" colspan="2">
       <widget class="QToolButton" name="backgroundColor">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="toolTip">
         <string>Color behind the model in the exported images.</string>
        </property>
        <property name="accessibleName">
         <string>Background Color</string>
        </property>
        <property name="toolButtonStyle">
         <enum>Qt::ToolButtonTextBesideIcon</enum>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="3">
       <widget class="QCheckBox" name="transparentImages">
        <property name="toolTip">
         <string>Save step images with a transparent background.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;&lt;b&gt;Transparent Background&lt;/b&gt;&lt;/p&gt;&lt;p&gt;When checked, the PNG step images have a transparent background so the page background can show through. When unchecked, they include the configured solid or gradient background with no transparency.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Transparent Background</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="PartsGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Parts List&lt;/b&gt;&lt;/p&gt;&lt;p&gt;After Each Step shows the parts added in that step. At the End shows the complete model inventory after the instructions. With Single Page and Override Instructions Settings they show or hide the step parts lists and the Bill of Materials page. You can enable either option, both, or neither.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Parts List</string>
     </property>
     <layout class="QVBoxLayout" name="PartsLayout">
      <item>
       <widget class="QCheckBox" name="partsAfterEachStep">
        <property name="toolTip">
         <string>Include a list of the parts added in each step.</string>
        </property>
        <property name="text">
         <string>After Each Step</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="partsAtTheEnd">
        <property name="toolTip">
         <string>Include a complete parts list after each model's instructions.</string>
        </property>
        <property name="text">
         <string>At the End</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <tabstops>
  <tabstop>outputFolder</tabstop>
  <tabstop>outputFolderBrowse</tabstop>
  <tabstop>allModels</tabstop>
  <tabstop>currentModelSubmodels</tabstop>
