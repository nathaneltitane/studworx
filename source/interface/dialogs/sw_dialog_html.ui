<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>swHTMLDialog</class>
 <widget class="QDialog" name="swHTMLDialog">
  <property name="whatsThis">
   <string>&lt;p&gt;&lt;b&gt;Export HTML&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Create browser-viewable building instructions and PNG images in the output folder. Choose which models to include, how to organize the step pages, and where to show parts lists.&lt;/p&gt;&lt;p&gt;Keep the generated HTML and image files together when copying or sharing the instructions.&lt;/p&gt;</string>
  </property>
  <property name="windowTitle">
   <string>HTML Options</string>
  </property>
  <layout class="QVBoxLayout" name="DialogLayout">
   <item>
    <widget class="QGroupBox" name="OutputGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Output Folder&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The exporter creates this folder if needed and writes the instruction pages and their images into it. Use a separate folder for each export to keep the generated files together.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Output</string>
     </property>
     <layout class="QGridLayout" name="OutputLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="OutputFolderLabel">
        <property name="toolTip">
         <string>Folder for the generated HTML pages and images.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;&lt;b&gt;Output Folder&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The exporter creates this folder if needed and writes the instruction pages and their images into it. Use a separate folder for each export to keep the generated files together.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Folder</string>
        </property>
        <property name="buddy">
         <cstring>outputFolder</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="outputFolder">
        <property name="toolTip">
         <string>Folder for the generated HTML pages and images.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;&lt;b&gt;Output Folder&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The exporter creates this folder if needed and writes the instruction pages and their images into it. Use a separate folder for each export to keep the generated files together.&lt;/p&gt;</string>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QToolButton" name="outputFolderBrowse">
        <property name="toolTip">
         <string>Choose the folder for the exported instructions.</string>
        </property>
        <property name="accessibleName">
         <string>Choose Output Folder</string>
        </property>
        <property name="text">
         <string>...</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="ModelsGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Models&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Export instructions for the model and all submodels, only the model or submodel being edited, or that entry with its referenced submodels. When several entries are exported, an overall index links to their instructions.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Models</string>
     </property>
     <layout class="QVBoxLayout" name="ModelsLayout">
      <item>
       <widget class="QRadioButton" name="allModels">
        <property name="toolTip">
         <string>Export instructions for the model and all submodels.</string>
        </property>
        <property name="text">
         <string>All Models</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="currentModelSubmodels">
        <property name="toolTip">
         <string>Export the current model and the submodels it references.</string>
        </property>
        <property name="text">
         <string>Current Model and Submodels</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="currentModelOnly">
        <property name="toolTip">
         <string>Export instructions only for the current model.</string>
        </property>
        <property name="text">
         <string>Current Model Only</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="PagesGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Pages&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Single Page places all steps for each model on one HTML page. One Step per Page creates separate pages with navigation links. In that mode, Index Page adds a page linking to the steps.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Pages</string>
     </property>
     <layout class="QVBoxLayout" name="PagesLayout">
      <item>
       <widget class="QRadioButton" name="singlePage">
        <property name="toolTip">
         <string>Put all steps for each model on one HTML page.</string>
        </property>
        <property name="text">
         <string>Single Page</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="oneStepPerPage">
        <property name="toolTip">
         <string>Create a separate HTML page for each step.</string>
        </property>
        <property name="text">
         <string>One Step per Page</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="indexPage">
        <property name="toolTip">
         <string>Add a step index when using One Step per Page.</string>
        </property>
        <property name="text">
         <string>Index Page</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="ImagesGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Step Images&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Width and Height set the step image size in pixels, from 1 to 32768 pixels. Transparent Background leaves the image background clear.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Step Images</string>
     </property>
     <layout class="QGridLayout" name="ImagesLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="StepWidthLabel">
        <property name="toolTip">
         <string>Width of each step image, in pixels.</string>
        </property>
        <property name="text">
         <string>Width</string>
        </property>
        <property name="buddy">
         <cstring>stepWidth</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1" colspan="2">
       <widget class="QLineEdit" name="stepWidth">
        <property name="toolTip">
         <string>Width of each step image, in pixels.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="StepHeightLabel">
        <property name="toolTip">
         <string>Height of each step image, in pixels.</string>
        </property>
        <property name="text">
         <string>Height</string>
        </property>
        <property name="buddy">
         <cstring>stepHeight</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1" colspan="2">
       <widget class="QLineEdit" name="stepHeight">
        <property name="toolTip">
         <string>Height of each step image, in pixels.</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="3">
       <widget class="QCheckBox" name="transparentImages">
        <property name="toolTip">
         <string>Save step images with a transparent background.</string>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;&lt;b&gt;Transparent Background&lt;/b&gt;&lt;/p&gt;&lt;p&gt;When checked, the PNG step images have a transparent background so the page background can show through. When unchecked, they include the configured solid or gradient background with no transparency.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Transparent Background</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="PartsGroup">
     <property name="whatsThis">
      <string>&lt;p&gt;&lt;b&gt;Parts List&lt;/b&gt;&lt;/p&gt;&lt;p&gt;After Each Step shows the parts added in that step. At the End shows the complete model inventory after the instructions. You can enable either option, both, or neither.&lt;/p&gt;</string>
     </property>
     <property name="title">
      <string>Parts List</string>
     </property>
     <layout class="QVBoxLayout" name="PartsLayout">
      <item>
       <widget class="QCheckBox" name="partsAfterEachStep">
        <property name="toolTip">
         <string>Include a list of the parts added in each step.</string>
        </property>
        <property name="text">
         <string>After Each Step</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="partsAtTheEnd">
        <property name="toolTip">
         <string>Include a complete parts list after each model's instructions.</string>
        </property>
        <property name="text">
         <string>At the End</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <tabstops>
  <tabstop>outputFolder</tabstop>
  <tabstop>outputFolderBrowse</tabstop>
  <tabstop>allModels</tabstop>
  <tabstop>currentModelSubmodels</tabstop>
  <tabstop>currentModelOnly</tabstop>
  <tabstop>singlePage</tabstop>
  <tabstop>oneStepPerPage</tabstop>
  <tabstop>indexPage</tabstop>
  <tabstop>stepWidth</tabstop>
  <tabstop>stepHeight</tabstop>
  <tabstop>transparentImages</tabstop>
  <tabstop>partsAfterEachStep</tabstop>
  <tabstop>partsAtTheEnd</tabstop>
 </tabstops>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>swHTMLDialog</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>swHTMLDialog</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
