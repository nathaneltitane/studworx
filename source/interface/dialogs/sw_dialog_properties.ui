     <widget class="QWidget" name="tabParts">
      <attribute name="title">
       <string>Parts</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="swPartsTableWidget" name="PartsTable">
         <property name="toolTip">
          <string>View part quantities by color; click a column heading to sort.</string>
         </property>
         <property name="whatsThis">
          <string>&lt;p&gt;&lt;b&gt;Parts&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The table counts parts across all steps, including parts inside submodels. The first column shows a thumbnail of each part in its most used color, and the ID column shows its number. Color columns show quantities, and totals summarize each part, each color, and the whole model. The Weight column shows the grams or ounces of each row, chosen with the units box below the table, from the BrickLink part weights, or N/A when unknown. Click a column heading to sort. The thumbnail, ID and part-name columns stay visible while you scroll horizontally. Counts cannot be edited here.&lt;/p&gt;</string>
         </property>
         <property name="accessibleName">
          <string>Parts</string>
         </property>
         <property name="editTriggers">
          <set>QAbstractItemView::NoEditTriggers</set>
         </property>
         <property name="sortingEnabled">
          <bool>true</bool>
         </property>
         <property name="selectionBehavior">
          <enum>QAbstractItemView::SelectRows</enum>
         </property>
         <attribute name="horizontalHeaderDefaultSectionSize">
          <number>75</number>
         </attribute>
         <attribute name="horizontalHeaderShowSortIndicator" stdset="0">
          <bool>true</bool>
         </attribute>
         <attribute name="verticalHeaderVisible">
          <bool>false</bool>
         </attribute>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="ExportLayout">
         <item>
          <widget class="QLabel" name="PartsCountLabel">
           <property name="toolTip">
            <string>Unique parts count each part and color combination once; total parts count every part in the model.</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="ExportSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>0</width>
             <height>0</height>
            </size>
           </property>
          </spacer>
         </item>
         <item>
          <widget class="QComboBox" name="WeightUnitCombo">
           <property name="toolTip">
            <string>Show the Weight column in metric or imperial units.</string>
           </property>
           <property name="whatsThis">
            <string>&lt;p&gt;&lt;b&gt;Weight Units&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Shows the Weight column in grams for Metric or ounces for Imperial. Sorting by weight is the same in both units.&lt;/p&gt;</string>
           </property>
           <property name="accessibleName">
            <string>Weight Units</string>
           </property>
           <item>
            <property name="text">
             <string>Metric</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Imperial</string>
            </property>
           </item>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="ExportBrickLinkButton">
           <property name="toolTip">
            <string>Save this model's part list as a BrickLink wanted list.</string>
           </property>
           <property name="whatsThis">
            <string>&lt;p&gt;&lt;b&gt;Export BrickLink&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Saves the parts listed in this table as a BrickLink XML wanted list, the same format as File &amp;gt; Export &amp;gt; BrickLink. Only the model shown in this dialog and its submodels are included.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Export BrickLink...</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="ExportCSVButton">
           <property name="toolTip">
            <string>Save this model's part list as a CSV spreadsheet.</string>
           </property>
           <property name="whatsThis">
            <string>&lt;p&gt;&lt;b&gt;Export CSV&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Saves the parts listed in this table as comma separated values with name, color, quantity, ID and color code, the same format as File &amp;gt; Export &amp;gt; CSV. Only the model shown in this dialog and its submodels are included.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Export CSV...</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
