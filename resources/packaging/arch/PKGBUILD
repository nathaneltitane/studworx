# Maintainer: Peter Bartfai <pbartfai[at]stardust[dot]hu>

pkgname=studworx
pkgver=20261112
pkgrel=1
pkgdesc="StudWorx: LDraw / LEGO® model builder"
url="https://github.com/nathaneltitane/studworx"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('qt5-base' 'qt5-svg' 'qt5-imageformats' 'zlib')
makedepends=('base-devel' 'qt5-tools')

# the optional modules are found at build time, install them before building

optdepends=(
	'qt5-gamepad: gamepad input'
	'kparts5: terminal panel, with a KDE Frameworks 5 konsole'
	'kio5: file manager thumbnails'
)

conflicts=()
replaces=()
backup=()
source=("studworx-git.tar.gz")
md5sums=(SKIP)

build () {

	cd "${srcdir}/studworx-git"

	qmake studworx.pro CONFIG+=release CONFIG-=debug INSTALL_PREFIX=/usr
	make
}

package () {

	cd "${srcdir}/studworx-git"

	make INSTALL_ROOT="${pkgdir}" install
}
