#!/bin/bash

# compile the translation catalogs into qm files

# usage: tools/studworx-language-release [language]

# stop on any error

set -e

# script folder

directory_script="${BASH_SOURCE[0]%/*}"

# run from its own directory

if [ "${directory_script}" = "${BASH_SOURCE[0]}" ]
then
	directory_script="."
fi

# source and catalog folders

directory_source="$(cd "${directory_script}/.." && pwd)"
directory_translations="${directory_source}/resources/translations"

# one language or all

language="${1:-*}"

# qt5 lrelease

tool_release="$(command -v lrelease || command -v lrelease-qt5)" || true

# stop without lrelease

if [ -z "${tool_release}" ]
then
	printf "%s\n" "lrelease not found"

	exit 1
fi

# compile each catalog

for file_catalog in "${directory_translations}"/studworx_${language}.ts
do
	# stop on an unknown language

	if [ ! -f "${file_catalog}" ]
	then
		printf "%s\n" "language not found: ${1}"

		exit 1
	fi

	# qm beside the catalog

	"${tool_release}" -silent "${file_catalog}" -qm "${file_catalog%.ts}.qm"
done
