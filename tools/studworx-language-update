#!/bin/bash

# refresh the translation catalogs from the source strings

# usage: tools/studworx-language-update [language]

# stop on any error

set -e

# script folder

directory_script="${BASH_SOURCE[0]%/*}"

# run from its own directory

if [ "${directory_script}" = "${BASH_SOURCE[0]}" ]
then
	directory_script="."
fi

# source and catalog folders

directory_source="$(cd "${directory_script}/.." && pwd)"
directory_translations="${directory_source}/resources/translations"

# one language or all

language="${1:-*}"

# qt5 lupdate

tool_update="$(command -v lupdate || command -v lupdate-qt5)" || true

# stop without lupdate

if [ -z "${tool_update}" ]
then
	printf "%s\n" "lupdate not found"

	exit 1
fi

# run from the repository

cd "${directory_source}"

# refresh each catalog

for file_catalog in "${directory_translations}"/studworx_${language}.ts
do
	# stop on an unknown language

	if [ ! -f "${file_catalog}" ]
	then
		printf "%s\n" "language not found: ${1}"

		exit 1
	fi

	# english keeps plural forms only

	if [ "${file_catalog##*/}" = "studworx_en.ts" ]
	then
		"${tool_update}" -pluralonly studworx.pro -ts "${file_catalog}"
	else
		"${tool_update}" -no-ui-lines studworx.pro -ts "${file_catalog}"
	fi
done
