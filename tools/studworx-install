#!/bin/bash

# build and install studworx

# usage: tools/studworx-install [prefix] [build directory]

# stop on any error

set -e

# script folder

directory_script="${BASH_SOURCE[0]%/*}"

# run from its own directory

if [ "${directory_script}" = "${BASH_SOURCE[0]}" ]
then
	directory_script="."
fi

# source, prefix and build folders

directory_source="$(cd "${directory_script}/.." && pwd)"
directory_prefix="${1:-/usr/local}"
directory_build="${2:-${directory_source}/build/install}"

# qt5 qmake

tool_qmake="$(command -v qmake || command -v qmake-qt5)" || true

# stop without qmake

if [ -z "${tool_qmake}" ]
then
	printf "%s\n" "qmake not found"

	exit 1
fi

# prefix from the closest existing directory

directory_writable="${directory_prefix}"

while [ ! -d "${directory_writable}" ]
do
	directory_writable="${directory_writable%/*}"
	directory_writable="${directory_writable:-/}"
done

command_run () {

	# use to run as superuser if needed

	local directory_target="${1}"

	if [ -w "${directory_target}" ]
	then
		"${@:2}"
	else
		sudo "${@:2}"
	fi

}

# build and install

mkdir -p "${directory_build}"

cd "${directory_build}"

"${tool_qmake}" "${directory_source}/studworx.pro"	\
	CONFIG+=release CONFIG-=debug					\
	INSTALL_PREFIX="${directory_prefix}"

# compile and install

make -j "$(nproc)"

command_run "${directory_writable}" make install

# kde thumbnail plugin

# qt plugin folders

directory_plugins="$("${tool_qmake}" -query QT_INSTALL_PLUGINS)"
directory_archdata="$("${tool_qmake}" -query QT_INSTALL_ARCHDATA)"
file_kio="${directory_archdata}/mkspecs/modules/qt_KIOGui.pri"

# only with kio

if [ -f "${file_kio}" ]
then
	mkdir -p "${directory_build}/thumbnailer"

	cd "${directory_build}/thumbnailer"

	"${tool_qmake}" "${directory_source}/source/thumbnailer/thumbnailer.pro"	\
		CONFIG+=release CONFIG-=debug											\
		BIN_DIR="${directory_prefix}/bin"

	# rebuild for the program path

	make clean
	make -j "$(nproc)"

	command_run "${directory_plugins}" make install

	cd "${directory_build}"
else
	printf "%s\n" "kde frameworks kio not found, thumbnail plugin skipped"
fi

# installed share and program

directory_share="${directory_prefix}/share"
file_program="${directory_prefix}/bin/studworx"

program_set () {

	# use to point entries at the binary

	local file_target="${1}"
	local lines_file
	local index_line

	# full program path

	mapfile -t lines_file < "${file_target}"

	for index_line in "${!lines_file[@]}"
	do
		lines_file[index_line]="${lines_file[index_line]/#TryExec=studworx/TryExec=${file_program}}"
		lines_file[index_line]="${lines_file[index_line]/#Exec=studworx /Exec=${file_program} }"
		lines_file[index_line]="${lines_file[index_line]/ studworx / ${file_program} }"
	done

	# write back

	printf "%s\n" "${lines_file[@]}" | command_run "${directory_writable}" tee "${file_target}" > /dev/null

}

# run without studworx on the path

program_set "${directory_share}/applications/studworx.desktop"

program_set "${directory_share}/thumbnailers/studworx.thumbnailer"

# trash old studworks entries

file_legacy="thumbnailers/studworks.thumbnailer"

for directory_legacy in "${directory_share}" "/usr/share"
do
	if [ -f "${directory_legacy}/${file_legacy}" ]
	then
		command_run "${directory_legacy}" gio trash "${directory_legacy}/${file_legacy}"
	fi
done

# refresh desktop caches

tool_mime="$(command -v update-mime-database)" || true
tool_desktop="$(command -v update-desktop-database)" || true
tool_icons="$(command -v gtk-update-icon-cache)" || true
tool_associate="$(command -v xdg-mime)" || true

# mime, desktop and icons

if [ -n "${tool_mime}" ]
then
	command_run "${directory_writable}" "${tool_mime}" "${directory_share}/mime"
fi

if [ -n "${tool_desktop}" ]
then
	command_run "${directory_writable}" "${tool_desktop}" "${directory_share}/applications"
fi

if [ -n "${tool_icons}" ]
then
	command_run "${directory_writable}" "${tool_icons}" -q -t "${directory_share}/icons/hicolor"
fi

# associate the desktop file types

list_types=()

while IFS= read -r line_desktop
do
	if [[ ${line_desktop} == MimeType=* ]]
	then
		IFS=";" read -r -a list_types <<< "${line_desktop#MimeType=}"
	fi
done < "${directory_source}/platform/studworx.desktop"

# default application

if [ -n "${tool_associate}" ] && [ "${#list_types[@]}" -gt 0 ]
then
	"${tool_associate}" default studworx.desktop "${list_types[@]}"
fi

# refresh kde service cache

for name_sycoca in kbuildsycoca6 kbuildsycoca5
do
	tool_sycoca="$(command -v "${name_sycoca}")" || true

	if [ -n "${tool_sycoca}" ]
	then
		"${tool_sycoca}" > /dev/null 2>&1

		break
	fi
done

# report the result

printf "%s\n" "studworx installed to ${directory_prefix}"
